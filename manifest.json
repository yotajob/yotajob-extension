{
  "manifest_version": 3,
  "name": "Yotajob",
  "version": "0.1.0",
  "description": "Save a job posting to your private Yotajob ledger, and fill application fields only after you review them.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://api.yotajob.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Yotajob"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
